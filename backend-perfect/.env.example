# Supabase server-side connection. Use the service_role key only in this backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# JWTs accepted by the backend. This is independent from TOTP_ENCRYPTION_KEY.
# Every accepted token must contain exp, sub (UUID), iss, and aud claims.
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=https://auth.example.internal
JWT_AUDIENCE=totp-api

# Base64 representation of exactly 32 random bytes; never use a JWT or a Supabase key here.
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-random-key
TOTP_ENCRYPTION_KEY_VERSION=v1

# Leave true in deployed environments. Configure the TLS proxy to forward the HTTPS scheme.
TOTP_REQUIRE_HTTPS=true
