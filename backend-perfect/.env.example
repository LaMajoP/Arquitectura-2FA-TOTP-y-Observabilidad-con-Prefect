# Supabase server-side connection. Use the service_role key only in this backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# JWTs accepted by the backend. This is independent from TOTP_ENCRYPTION_KEY.
# Every accepted token must contain exp, sub (UUID), iss, and aud claims.
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=https://auth.example.internal
JWT_AUDIENCE=totp-api

# Separate server-only HMAC key (at least 32 random bytes) used to derive
# opaque authentication rate-limit subjects. Do not reuse the JWT or AES key.
AUTH_RATE_LIMIT_KEY=replace-with-at-least-32-random-bytes

# Base64 representation of exactly 32 random bytes; never use a JWT or a Supabase key here.
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-random-key
TOTP_ENCRYPTION_KEY_VERSION=v1

# Leave true in deployed environments. Configure the TLS proxy to forward the HTTPS scheme.
TOTP_REQUIRE_HTTPS=true

# Five code checks are allowed; after the fifth, verification is locked for
# 15 minutes. These limits are shared by every backend instance through Supabase.
TOTP_VERIFY_MAX_ATTEMPTS=5
TOTP_VERIFY_LOCK_SECONDS=900

# Password login permits five failed checks before a shared 15-minute lock.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900

# JWT lifetimes in seconds. A pre-auth JWT is accepted only by verify-mfa;
# provisioning JWTs are accepted only by the existing TOTP setup/verify routes.
AUTH_PRE_AUTH_TOKEN_TTL_SECONDS=300
AUTH_PROVISIONING_TOKEN_TTL_SECONDS=900
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# Replacing every recovery code requires an access JWT issued by a Step-Up MFA
# completed within this many seconds. The default is five minutes.
AUTH_BACKUP_CODE_RECENT_MFA_SECONDS=300
